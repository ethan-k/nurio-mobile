# Nurio customer mobile deployment lanes.
#
# iOS lanes build and upload the version currently written in the Xcode
# project. Android beta advances versionName's patch component and versionCode
# beyond both the checked-in value and the current Play tracks before upload.
#
# Credentials come from the shared workspace shell environment. These names
# are deliberately unprefixed: one Apple Developer account and one Play
# publisher service account serve every app in this workspace, so the same
# variables work for Nurio and its siblings. Do not rename or add a
# NURIO_ prefix.
#
#   APP_STORE_CONNECT_KEY_IDENTIFIER  App Store Connect API key ID
#   APP_STORE_CONNECT_ISSUER_ID       App Store Connect issuer UUID
#   APP_STORE_CONNECT_PRIVATE_KEY     AuthKey_<KEY_IDENTIFIER>.p8 PEM text
#   APPLE_TEAM_ID                     Developer Portal team ID (read by Appfile)
#   PLAY_SERVICE_ACCOUNT_JSON_BASE64  Play publisher service-account JSON, base64

require "base64"
require "fileutils"
require "json"
require "shellwords"
require "tmpdir"

IOS_REQUIRED_VARIABLES = %w[APP_STORE_CONNECT_KEY_IDENTIFIER APP_STORE_CONNECT_ISSUER_ID APP_STORE_CONNECT_PRIVATE_KEY].freeze
ANDROID_REQUIRED_VARIABLES = %w[PLAY_SERVICE_ACCOUNT_JSON_BASE64].freeze

# Credential decoding lives in a module so the memoized temp-key path survives
# across lane, after_all, and error blocks, which do not share `self`.
module NurioCredentials
  extend self

  def present?(value)
    !value.nil? && !value.to_s.strip.empty?
  end

  def available?(names)
    names.all? { |name| present?(ENV[name]) }
  end

  def require!(names)
    missing = names.reject { |name| present?(ENV[name]) }
    return if missing.empty?

    UI.user_error!(
      "missing release credentials: #{missing.sort.join(', ')}. These are " \
      "exported by the shared workspace shell environment and are never read " \
      "from this repository."
    )
  end

  def fetch!(name)
    require!([ name ])
    ENV.fetch(name)
  end

  def decode!(name)
    Base64.strict_decode64(fetch!(name).gsub(/\s+/, ""))
  rescue ArgumentError
    UI.user_error!("#{name} is not valid base64")
  end

  # xcodebuild's -authenticationKeyPath needs the key on disk. The env var
  # holds the raw .p8 PEM text; it is written verbatim to a 0600 temp file and
  # removed when the run finishes. No base64, no decoding.
  def asc_key_path
    @asc_key_path ||= begin
      path = File.join(Dir.tmpdir, "nurio-AuthKey_#{fetch!('APP_STORE_CONNECT_KEY_IDENTIFIER')}.p8")
      FileUtils.rm_f(path)
      File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write(fetch!("APP_STORE_CONNECT_PRIVATE_KEY"))
      end
      path
    end
  end

  def discard_asc_key!
    FileUtils.rm_f(@asc_key_path) if @asc_key_path
    @asc_key_path = nil
  end

  def play_json_key_data
    @play_json_key_data ||= begin
      decoded = decode!("PLAY_SERVICE_ACCOUNT_JSON_BASE64")

      parsed =
        begin
          JSON.parse(decoded)
        rescue JSON::ParserError
          UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON_BASE64 does not decode to JSON")
        end

      unless parsed["type"] == "service_account" && present?(parsed["client_email"])
        UI.user_error!(
          "PLAY_SERVICE_ACCOUNT_JSON_BASE64 must decode to a Play publisher " \
          "service-account key"
        )
      end

      decoded
    end
  end
end

before_all do
  # Lanes run with the repo root as fastlane's working directory root.
  ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"

  # bundle exec exports RUBYOPT/BUNDLE_*/GEM_* to child processes; ruby
  # helpers spawned by xcodebuild can crash loading a mismatched bundler.
  # fastlane is fully loaded by now and no longer needs them.
  %w[RUBYOPT BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLER_SETUP BUNDLER_VERSION GEM_HOME GEM_PATH].each do |var|
    ENV.delete(var)
  end

  # gradlew needs JAVA_HOME to launch; Android Studio's bundled JBR is the
  # JDK this machine builds with.
  jbr = "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
  ENV["JAVA_HOME"] ||= jbr if File.directory?(jbr)

  sdk = File.expand_path("~/Library/Android/sdk")
  ENV["ANDROID_HOME"] ||= sdk if File.directory?(sdk)
end

after_all do
  NurioCredentials.discard_asc_key!
end

error do |_lane, _exception|
  NurioCredentials.discard_asc_key!
end

def nurio_asc_api_key
  NurioCredentials.require!(IOS_REQUIRED_VARIABLES)

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
    in_house: false
  )
end

# fastlane runs lanes with Dir.pwd set to <project>/fastlane, so resolve against
# the project root (parent of fastlane/) at runtime, matching nurio_gradle_file.
# The path is pinned rather than left to Xcode's hashed default because SPM
# checks firebase-ios-sdk out underneath it, and that is where upload-symbols
# lives. Keep it outside ios/ (Xcode's SRCROOT) so User Script Sandboxing can
# execute Firebase's Crashlytics scripts from the SPM checkout.
def nurio_ios_derived_data_path
  File.expand_path("../build/ios-derived-data", Dir.pwd)
end

def nurio_ios_crashlytics_upload_symbols
  File.join(
    nurio_ios_derived_data_path,
    "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
  )
end

platform :ios do
  desc "Check App Store Connect credentials without building or uploading"
  lane :validate do
    nurio_asc_api_key
    UI.success("App Store Connect API key #{ENV.fetch('APP_STORE_CONNECT_KEY_IDENTIFIER')} loaded")
  end

  desc "Archive and export a signed App Store IPA (no upload)"
  lane :build do
    # skipPackagePluginValidation/skipMacroValidation: headless xcodebuild
    # cannot approve SPM plugins interactively.
    xcargs = "-allowProvisioningUpdates -skipPackagePluginValidation -skipMacroValidation"

    # With the ASC API key, automatic signing works headless (cloud signing)
    # even when no Xcode account session is available to xcodebuild.
    if NurioCredentials.available?(IOS_REQUIRED_VARIABLES)
      xcargs += " -authenticationKeyID #{ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER")}" \
                " -authenticationKeyIssuerID #{ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")}" \
                " -authenticationKeyPath #{NurioCredentials.asc_key_path.shellescape}"
    else
      UI.important(
        "#{IOS_REQUIRED_VARIABLES.join(', ')} not set — signing falls back to " \
        "the local Xcode account session, which fails headless."
      )
    end

    build_app(
      project: "ios/Nurio.xcodeproj",
      derived_data_path: nurio_ios_derived_data_path,
      scheme: "Nurio",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build/fastlane",
      # Raw output: the xcpretty formatter is a system-Ruby script that can
      # crash under bundle exec and kill the archive via pipefail.
      xcodebuild_formatter: "",
      xcargs: xcargs,
      export_options: {
        signingStyle: "automatic"
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = nurio_asc_api_key
    build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload App Store Connect dSYMs to Crashlytics (run after TestFlight finishes processing)"
  lane :refresh_dsyms do |options|
    api_key = nurio_asc_api_key

    upload_symbols = nurio_ios_crashlytics_upload_symbols
    unless File.executable?(upload_symbols)
      UI.user_error!(
        "upload-symbols is missing at #{upload_symbols}. Run `fastlane ios build` " \
        "first so SPM resolves firebase-ios-sdk into the pinned derived data path."
      )
    end

    # beta returns before App Store Connect finishes processing, so the dSYMs it
    # generates do not exist yet when that lane exits. Without this follow-up the
    # build-phase dSYM covers only locally archived symbols and TestFlight
    # crashes stay unsymbolicated.
    download_dsyms(
      api_key: api_key,
      version: options[:version] || "latest",
      build_number: options[:build_number],
      wait_for_dsym_processing: true,
      wait_timeout: 1800
    )

    if Actions.lane_context[SharedValues::DSYM_PATHS].to_a.empty?
      UI.important("No new dSYMs to upload")
      next
    end

    upload_symbols_to_crashlytics(
      gsp_path: File.expand_path("../ios/GoogleService-Info.plist", Dir.pwd),
      binary_path: upload_symbols
    )

    clean_build_artifacts
  end

  desc "Build and upload to App Store Connect for release review (metadata untouched)"
  lane :release do
    api_key = nurio_asc_api_key
    build
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end
end

NURIO_ANDROID_PACKAGE = "com.nurio.android".freeze

# fastlane runs lanes with Dir.pwd set to <project>/fastlane, so resolve the
# gradle file against the project root (parent of fastlane/) at runtime.
def nurio_gradle_file
  File.expand_path("../android/app/build.gradle.kts", Dir.pwd)
end

# Best practice: the store is the monotonic source of truth for versionCode.
# next_code = max(file_code + 1, highest_code_on_production + 1, highest_code_on_internal + 1)
# so Play can never reject a build as "version code already used".
def nurio_read_version_code
  match = File.read(nurio_gradle_file).match(/versionCode\s*=\s*(\d+)/)
  UI.user_error!("Cannot read versionCode from #{nurio_gradle_file}") unless match
  match[1].to_i
end

def nurio_read_version_name
  match = File.read(nurio_gradle_file).match(/versionName\s*=\s*"([^"]+)"/)
  UI.user_error!("Cannot read versionName from #{nurio_gradle_file}") unless match
  match[1]
end

def nurio_next_version_name(current)
  match = current.match(/\A(\d+)\.(\d+)\.(\d+)\z/)
  unless match
    UI.user_error!(
      "Cannot auto-bump versionName '#{current}'; expected a numeric major.minor.patch version"
    )
  end

  "#{match[1]}.#{match[2]}.#{match[3].to_i + 1}"
end

# Refuse to auto-bump a file that already contains staged or unstaged work.
# After this gate, staging the complete file is safe because this lane owns its
# only worktree change: the versionName and versionCode replacements below.
def nurio_require_clean_gradle_file!
  repo_root = `git rev-parse --show-toplevel`.strip
  gradle_rel = nurio_gradle_file.delete_prefix("#{repo_root}/")
  unstaged_clean = system("git", "-C", repo_root, "diff", "--quiet", "--", gradle_rel)
  staged_clean = system("git", "-C", repo_root, "diff", "--cached", "--quiet", "--", gradle_rel)
  return if unstaged_clean && staged_clean

  UI.user_error!(
    "#{gradle_rel} already has pending changes. Commit or stash that file " \
    "before running android beta so the release bump cannot absorb them."
  )
end

def nurio_play_max_version_code(json_key_data:)
  %w[production internal].filter_map do |track|
    google_play_track_version_codes(
      package_name: NURIO_ANDROID_PACKAGE,
      track: track,
      json_key_data: json_key_data
    ).map(&:to_i).max
  rescue StandardError => e
    UI.important("Could not read Play '#{track}' track version codes: #{e.message}")
    nil
  end.max.to_i
end

def nurio_bump_android_version!(json_key_data:)
  current_code = nurio_read_version_code
  current_name = nurio_read_version_name
  play_max = nurio_play_max_version_code(json_key_data: json_key_data)
  next_code = [ current_code + 1, play_max + 1 ].max
  next_name = nurio_next_version_name(current_name)
  contents = File.read(nurio_gradle_file)
  contents.sub!(/versionCode\s*=\s*\d+/, "versionCode = #{next_code}")
  contents.sub!(/versionName\s*=\s*"[^"]+"/, "versionName = \"#{next_name}\"")
  File.write(
    nurio_gradle_file,
    contents
  )
  UI.message("versionCode #{current_code} (file) / #{play_max} (Play max) -> #{next_code}")
  UI.message("versionName #{current_name} -> #{next_name}")
  [ next_code, next_name ]
end

# Commit only the Android version bump in build.gradle.kts after a successful upload,
# so the file's monotonic floor tracks what actually shipped. Scoped to that one
# file so unrelated working-tree changes are never swept into a release commit.
def nurio_commit_version_bump!(code:, name:)
  repo_root = sh("git rev-parse --show-toplevel").strip
  gradle_rel = nurio_gradle_file.delete_prefix("#{repo_root}/")
  sh("git -C #{Shellwords.escape(repo_root)} add -- #{Shellwords.escape(gradle_rel)}")

  staged = sh("git -C #{Shellwords.escape(repo_root)} diff --cached --name-only -- #{Shellwords.escape(gradle_rel)}").strip
  if staged.empty?
    UI.message("Android version bump already committed; nothing to commit")
    return
  end

  message = "chore(release): bump Nurio Android to #{name} (#{code})"
  sh("git -C #{Shellwords.escape(repo_root)} commit -m #{Shellwords.escape(message)} -- #{Shellwords.escape(gradle_rel)}")
  UI.success("Committed version bump: #{message}")
end

platform :android do
  desc "Check the Play publisher credentials without building or uploading"
  lane :validate do
    validate_play_store_json_key(json_key_data: NurioCredentials.play_json_key_data)
    UI.success("Play publisher service account authenticated")
  end

  desc "Build the signed release AAB (no upload)"
  lane :build do
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )
  end

  desc "Build and upload to Play internal (auto-bumps versionName patch and versionCode)"
  lane :beta do
    NurioCredentials.require!(ANDROID_REQUIRED_VARIABLES)
    json_key_data = NurioCredentials.play_json_key_data
    nurio_require_clean_gradle_file!

    # versionCode is sourced from Play itself, so the upload can never collide
    # with a previously accepted code. versionName advances one patch release.
    next_code, version_name = nurio_bump_android_version!(json_key_data: json_key_data)
    UI.success("Deploying Nurio Android: #{version_name} (#{next_code}) -> Play internal track")

    build
    upload_to_play_store(
      json_key_data: json_key_data,
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      # The gradle lane context also advertises any stale debug/release APKs
      # left in outputs/apk, and supply refuses an APK and an AAB together.
      skip_upload_apk: true,
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Only reached on a successful upload (fastlane aborts on failure). Record the
    # versionName and versionCode bump so the shipped state is committed.
    nurio_commit_version_bump!(code: next_code, name: version_name)
  end

  desc "Promote the internal build to production (no rebuild)"
  lane :promote do
    upload_to_play_store(
      json_key_data: NurioCredentials.play_json_key_data,
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
