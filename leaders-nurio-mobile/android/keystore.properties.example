# Release signing normally needs no file at all: the build reads the shared
# vault environment first, and that is what the Fastlane lanes rely on.
#
#   NURIO_STUDY_LEADER_ANDROID_KEYSTORE_PATH            absolute path to the upload keystore
#   NURIO_STUDY_LEADER_ANDROID_KEYSTORE_ALIAS           key alias inside that keystore
#   NURIO_STUDY_LEADER_ANDROID_KEYSTORE_STORE_PASSWORD  keystore password
#
# Copy this file to keystore.properties only for a checkout without the vault
# exported. DO NOT commit keystore.properties to version control.
#
# storeFile is resolved from the android/ Gradle root, so keep it relative to
# this file (an absolute path also works).
#
# The upload keystore is PKCS12, which carries one password for the store and
# the key alike, so there is no separate key password to set here.

storeFile=your-release.jks
storePassword=your_store_password
keyAlias=your_key_alias
