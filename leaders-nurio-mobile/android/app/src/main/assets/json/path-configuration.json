{
  "settings": {
    "screenshots_enabled": true
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/new$",
        "/edit$",
        ".*/new$",
        ".*/edit$"
      ],
      "properties": {
        "context": "modal",
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": [
        "/login.*",
        "/signup.*",
        "/auth/.*"
      ],
      "properties": {
        "context": "modal",
        "uri": "hotwire://fragment/web/modal",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
